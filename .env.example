VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_ENABLE_ADMIN_PANEL=false
VITE_ENABLE_INTERNAL_CONTENT_FIXTURES=false
VITE_ADMIN_EMAILS=nickblanchardbusiness@gmail.com
VITE_ADMIN_PREVIEW_PASSKEY_SHA256=
VITE_ENABLE_ANALYTICS=false
VITE_DEBUG_ANALYTICS=false
VITE_GA_MEASUREMENT_ID=
VITE_GTM_CONTAINER_ID=
VITE_ENABLE_META_PIXEL=false
VITE_META_PIXEL_ID=

# Local authenticated Playwright QA. Copy these into .env.local only.
# Do not commit real credentials.
PLAYWRIGHT_QA_EMAIL=qa@nursecommand.com
PLAYWRIGHT_QA_PASSWORD=
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_PORT=4179

# Local-only admin key used by scripts/create-playwright-qa-user.mjs.
# Never expose this in browser Vite env vars or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function email delivery for friend request notifications.
# Set these as Supabase Function secrets in production, not browser Vite env vars.
RESEND_API_KEY=
FRIEND_REQUEST_EMAIL_FROM="Nurse Command <support@nursecommand.com>"
FRIEND_REQUEST_EMAIL_REPLY_TO=support@nursecommand.com
FRIEND_REQUEST_EMAIL_BASE_URL=https://nursecommand.com
